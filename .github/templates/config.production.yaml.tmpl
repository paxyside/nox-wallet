# =============================================================================
# Nox-Wallet Production Configuration Template
# =============================================================================
# Rendered into `config.yaml` on CI via `envsubst` before `task build:dmg`
# packages the macOS bundle. The substituted values come from GitHub
# Actions secrets — never committed in plaintext.
#
# Required secrets:
#   ALCHEMY_KEY    — Alchemy app key (restrict to bundle id `com.nox.wallet`
#                    in the Alchemy dashboard so an extracted key can't be
#                    reused in someone else's app).
#   COINGECKO_KEY  — CoinGecko Demo-tier API key (free, 30 req/min).
#
# When editing this file, mirror non-secret changes back into
# `config.example.yaml` so local dev keeps working.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
app:
  name: "nox-wallet"
  version: "0.1.0"
  environment: "production"
  shutdown_timeout: 30s

  retry:
    max_retries: 3
    base_delay: 100ms
    max_delay: 5s

# -----------------------------------------------------------------------------
# gRPC Server (localhost-only — Flutter connects on the same machine)
# -----------------------------------------------------------------------------
grpc:
  enabled: true
  host: "127.0.0.1"
  port: 50055
  authorization: ""
  reflection: false
  shutdown_timeout: 10s

# -----------------------------------------------------------------------------
# Logger
# -----------------------------------------------------------------------------
logger:
  level: "info"
  format: "json"
  add_source: false
  pretty: false

# -----------------------------------------------------------------------------
# Ethereum
# -----------------------------------------------------------------------------
ethereum:
  network: "ethereum"
  http_url: "https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}"
  alchemy_key: "${ALCHEMY_KEY}"
  networks_file: ""

# -----------------------------------------------------------------------------
# Pricefeed (CoinGecko)
# -----------------------------------------------------------------------------
pricefeed:
  coingecko_key: "${COINGECKO_KEY}"
  coingecko_plan: "demo"
